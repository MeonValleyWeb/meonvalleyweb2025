---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { business, locations } from '../data/site';
import LeadMagnetPopup from '../components/LeadMagnetPopup.astro';
import TrustSignals from '../components/TrustSignals.astro';
import TechStrip from '../components/TechStrip.astro';
import twoDogsImg from '../assets/twodogsananawning.webp';

const services = [
  {
    title: 'Win more enquiries',
    text: 'Clear positioning, confident design and an obvious next step for the people you want to reach.',
    href: '/web-design-hampshire',
    link: 'Explore web design',
  },
  {
    title: 'Sell and publish online',
    text: 'WordPress, ecommerce and content systems selected around how your team actually works.',
    href: '/services',
    link: 'Explore development',
  },
  {
    title: 'Keep WordPress healthy',
    text: 'Practical help for slow, broken or compromised sites, followed by sensible ongoing care.',
    href: '/wordpress-doctor',
    link: 'Meet the WordPress Doctor',
  },
  {
    title: 'Stay fast and supported',
    text: 'Managed hosting, daily backups, security updates and direct Hampshire support.',
    href: '/hosting',
    link: 'View hosting and care',
  },
];
---

<MainLayout
  title="Web Design Hampshire | Meon Valley Web"
  description="Modern web design for Hampshire businesses. Fast, accessible Astro and WordPress websites with honest local support."
  ogImage="/portfolio/sdsa.webp"
  ogImageAlt="A selection of websites built by Meon Valley Web"
>
  <section class="home-hero overflow-hidden bg-[#f7f7f5]" aria-labelledby="home-title">
    <div class="mx-auto grid min-h-[calc(100dvh-4.5rem)] max-w-7xl grid-cols-1 items-center gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <h1 id="home-title" class="text-5xl font-bold leading-[0.98] tracking-[-0.045em] text-gray-950 sm:text-6xl">
          Hampshire web design that <span class="text-primary-600">works.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-600 sm:text-xl">
          Fast, accessible websites with honest local support, built around your business goals.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/free-site-audit" class="inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-primary-600 px-7 py-4 text-base font-semibold text-white transition hover:-translate-y-0.5 hover:bg-primary-700 active:translate-y-px">
            Request a free site audit
          </a>
          <a href="/portfolio" class="inline-flex items-center justify-center whitespace-nowrap rounded-xl border border-gray-300 bg-white px-7 py-4 text-base font-semibold text-gray-950 transition hover:-translate-y-0.5 hover:border-gray-950 active:translate-y-px">
            View recent work
          </a>
        </div>
      </div>

      <div class="project-montage relative mx-auto w-full max-w-3xl lg:ml-auto" role="group" aria-label="Recent website projects">
        <article class="project-frame project-frame-main bg-white p-3 shadow-[0_30px_80px_-42px_rgba(17,24,39,0.5)]">
          <Image
            src={twoDogsImg}
            alt="Two Dogs and an Awning website homepage"
            class="aspect-[16/10] w-full object-cover"
            widths={[680, 1020, 1360]}
            sizes="(min-width: 1024px) 620px, 92vw"
            fetchpriority="high"
          />
          <div class="flex items-center justify-between gap-4 px-2 pb-1 pt-3">
            <p class="font-semibold text-gray-950">Two Dogs and an Awning</p>
            <p class="text-sm text-gray-700">WordPress and charity fundraising</p>
          </div>
        </article>

        <article class="project-frame project-frame-small project-frame-left bg-white p-2 shadow-[0_24px_60px_-36px_rgba(17,24,39,0.55)]">
          <img src="/portfolio/sdsa.webp" alt="Saints Disabled Supporters Association website" class="aspect-[4/3] w-full object-cover" loading="eager" decoding="async" />
          <p class="px-1 pb-1 pt-2 text-sm font-semibold text-gray-950">Accessible supporter services</p>
        </article>

        <article class="project-frame project-frame-small project-frame-right bg-gray-950 p-2 text-white shadow-[0_24px_60px_-36px_rgba(17,24,39,0.7)]">
          <img src="/portfolio/wessexwhiskyclub.webp" alt="Wessex Whisky Club website" class="aspect-[4/3] w-full object-cover" loading="eager" decoding="async" />
          <p class="px-1 pb-1 pt-2 text-sm font-semibold">Membership and events</p>
        </article>
      </div>
    </div>
  </section>

  <TrustSignals />

  <section class="reveal-block bg-white py-20 sm:py-24" aria-labelledby="selected-work-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary-700">Selected work</p>
        <h2 id="selected-work-title" class="mt-3 text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl">Real work for organisations with something useful to do.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">Each project starts with the audience, the job they need to complete and the clearest route through.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[1.4fr_0.8fr] lg:grid-rows-2">
        <a href="/portfolio/walking-hiking-wordpress" class="work-cell group bg-[#f3f3f0] p-4 lg:row-span-2 lg:p-6">
          <Image src={twoDogsImg} alt="Two Dogs and an Awning walking website" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.015]" widths={[700, 1050, 1400]} sizes="(min-width: 1024px) 700px, 92vw" loading="lazy" />
          <div class="px-1 pb-2 pt-6">
            <h3 class="text-2xl font-bold text-gray-950">A walking library built around more than 900 routes</h3>
            <p class="mt-2 text-gray-600">Content structure, search and fundraising support for Two Dogs and an Awning.</p>
          </div>
        </a>

        <a href="/portfolio/saints-disabled-association" class="work-cell group grid grid-cols-[0.9fr_1.1fr] items-center gap-5 bg-gray-950 p-4 text-white sm:p-5">
          <img src="/portfolio/sdsa.webp" alt="Saints Disabled Supporters Association website" class="aspect-square w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" decoding="async" />
          <div>
            <h3 class="text-xl font-bold">Accessible ticket workflows</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-300">Clear forms and administration for disabled supporters.</p>
          </div>
        </a>

        <a href="/portfolio/wessex-whisky-ecommerce" class="work-cell group grid grid-cols-[1.1fr_0.9fr] items-center gap-5 bg-primary-600 p-4 text-white sm:p-5">
          <div>
            <h3 class="text-xl font-bold">Membership, events and charity</h3>
            <p class="mt-2 text-sm leading-relaxed text-primary-50">A focused club experience that makes each event easy to discover.</p>
          </div>
          <img src="/portfolio/wessexwhiskyclub.webp" alt="Wessex Whisky Club website" class="aspect-square w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
  </section>

  <section class="reveal-block bg-[#f7f7f5] py-20 sm:py-24" aria-labelledby="services-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 id="services-title" class="text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl">Start with the business problem.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">The framework comes later. First we decide what the website needs to help somebody do.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 border-t border-gray-300 md:grid-cols-2">
        {services.map((service, index) => (
          <article class:list={[
            'border-b border-gray-300 py-8 md:py-10',
            index % 2 === 0 ? 'md:pr-10' : 'md:border-l md:pl-10',
          ]}>
            <h3 class="text-2xl font-bold text-gray-950">{service.title}</h3>
            <p class="mt-3 max-w-xl leading-relaxed text-gray-600">{service.text}</p>
            <a href={service.href} class="mt-6 inline-flex font-semibold text-primary-700 underline decoration-primary-300 underline-offset-4 transition hover:text-primary-900">{service.link}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <TechStrip />

  <section class="reveal-block bg-white py-20 sm:py-24" aria-labelledby="experience-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:grid-rows-2">
        <div class="experience-photo overflow-hidden bg-gray-100 lg:row-span-2">
          <img src="/sophie-and-dad-canoeing.jpg" alt="Andrew and Sophie canoeing together" class="h-full min-h-[28rem] w-full object-cover" loading="eager" fetchpriority="low" decoding="async" />
        </div>
        <article class="bg-gray-950 p-8 text-white sm:p-10">
          <h2 id="experience-title" class="text-3xl font-bold tracking-tight">Experience that reaches beyond a single platform.</h2>
          <p class="mt-5 leading-relaxed text-gray-300">Andrew's earlier digital work includes HSBC, Hoseasons, Eastern Electricity, French Country Cottages and TravelBag.</p>
          <a href="/about" class="mt-7 inline-flex font-semibold text-primary-300 underline decoration-primary-500 underline-offset-4 hover:text-white">Meet Andrew</a>
        </article>
        <article class="bg-primary-600 p-8 text-white sm:p-10">
          <p class="text-4xl font-bold tracking-tight">£300,000+</p>
          <h2 class="mt-3 text-2xl font-bold">Raised through Sophie's Gift Ball</h2>
          <p class="mt-4 leading-relaxed text-primary-50">That experience shaped an ongoing commitment to charity websites and local causes.</p>
          <a href="/charity" class="mt-7 inline-flex font-semibold text-white underline decoration-primary-300 underline-offset-4">Read the community story</a>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-[#f7f7f5] py-20" aria-labelledby="testimonial-title">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <h2 id="testimonial-title" class="sr-only">Client testimonial</h2>
      <blockquote class="text-3xl font-semibold leading-tight tracking-tight text-gray-950 sm:text-4xl">“The support and service provided by Andrew at Meon Valley Web is first class.”</blockquote>
      <p class="mt-6 font-semibold text-gray-950">Paul Fredericks</p>
      <p class="mt-1 text-gray-600">Two Dogs and an Awning</p>
    </div>
  </section>

  <section class="bg-white py-16" aria-labelledby="areas-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="areas-title" class="text-3xl font-bold tracking-tight text-gray-950">Web design across Hampshire</h2>
      <p class="mt-3 max-w-2xl text-gray-600">Based in the Meon Valley and working with businesses across the county and South Coast.</p>
      <div class="location-scroll mt-8 flex snap-x gap-3 overflow-x-auto pb-3">
        {locations.map((location) => (
          <a href={`/web-design-${location.slug}`} class="snap-start whitespace-nowrap rounded-xl border border-gray-300 bg-[#f7f7f5] px-5 py-3 font-semibold text-gray-800 transition hover:border-primary-600 hover:text-primary-700">{location.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary-600 py-20 text-white" aria-labelledby="audit-title">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 id="audit-title" class="text-4xl font-bold tracking-tight sm:text-5xl">Find the clearest improvement first.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-primary-50">Get a short, practical review of your website's speed, search visibility, accessibility and trust signals.</p>
      <a href="/free-site-audit" class="mt-8 inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-gray-950 px-7 py-4 text-base font-semibold text-white transition hover:-translate-y-0.5 hover:bg-gray-900 active:translate-y-px">Request a free site audit</a>
      <p class="mt-4 text-sm text-primary-100">No pressure and no generic automated report.</p>
    </div>
  </section>

  <LeadMagnetPopup />
</MainLayout>

<style>
  .project-frame,
  .work-cell,
  .experience-photo {
    border-radius: 1rem;
  }

  .project-montage {
    padding: 3.5rem 1rem 4.5rem;
  }

  .project-frame-main {
    position: relative;
    z-index: 2;
    transform: rotate(-1.5deg);
  }

  .project-frame-small {
    position: absolute;
    z-index: 3;
    width: min(44%, 17rem);
  }

  .project-frame-left {
    bottom: 0.5rem;
    left: -0.5rem;
    transform: rotate(2.5deg);
  }

  .project-frame-right {
    right: -0.25rem;
    top: 0;
    transform: rotate(3deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-frame-main { animation: hero-settle 900ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    .project-frame-left { animation: hero-left 1s 120ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    .project-frame-right { animation: hero-right 1s 220ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  }

  @keyframes hero-settle {
    from { transform: translateY(28px) rotate(-3deg); }
    to { transform: translateY(0) rotate(-1.5deg); }
  }

  @keyframes hero-left {
    from { transform: translate(-18px, 24px) rotate(5deg); }
    to { transform: translate(0, 0) rotate(2.5deg); }
  }

  @keyframes hero-right {
    from { transform: translate(20px, -12px) rotate(6deg); }
    to { transform: translate(0, 0) rotate(3deg); }
  }

  @media (max-width: 767px) {
    .project-montage { padding: 2rem 0 3.5rem; }
    .project-frame-small { width: 43%; }
    .project-frame-left { left: 0; }
    .project-frame-right { right: 0; }
  }
</style>
