---
import MainLayout from '../layouts/MainLayout.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';

const auditAreas = [
  { number: '01', title: 'Speed & stability', summary: 'Find the delays and visual jumps that make a site feel unreliable.', checks: ['Largest Contentful Paint (LCP)', 'Cumulative Layout Shift (CLS)', 'Interaction speed and render blockers'] },
  { number: '02', title: 'Accessibility', summary: 'Make sure every visitor can read, navigate, and complete your key journeys.', checks: ['Keyboard navigation and focus order', 'Colour contrast and readable type', 'Forms, labels, and screen-reader basics'] },
  { number: '03', title: 'Search visibility', summary: 'Check whether search engines can understand, trust, and surface your pages.', checks: ['Titles, descriptions, canonicals, and headings', 'Indexing, robots.txt, and XML sitemap', 'Local signals, structured data, and internal links'] },
  { number: '04', title: 'Cookies & privacy', summary: 'Spot consent friction and compliance gaps before they cost you trust.', checks: ['Cookie banner behaviour and choice clarity', 'Non-essential scripts before consent', 'Privacy-page and tracking disclosures'] },
  { number: '05', title: 'Trust & resilience', summary: 'Review the technical signals that reassure visitors and protect enquiries.', checks: ['HTTPS, security headers, and mixed content', 'Form handling, error states, and spam controls', 'Mobile behaviour and broken user journeys'] },
  { number: '06', title: 'Conversion clarity', summary: 'Turn a busy page into a clearer path from first impression to enquiry.', checks: ['Hero message and primary call to action', 'Service proof, case studies, and objections', 'Contact friction and next-step clarity'] },
];
---

<MainLayout
  title="Free Website Improvement Report | Meon Valley Web"
  description="Get a free one-page website improvement report covering speed, CLS, accessibility, SEO, cookies, privacy, security, and conversion opportunities."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Free website audit' }]}
>
  <section class="relative overflow-hidden bg-[#111315] py-16 sm:py-20 lg:py-28">
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 75% 15%, #c51d65 0, transparent 27%), linear-gradient(115deg, transparent 0 46%, #272b2e 46% 47%, transparent 47%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-20 items-center">
        <div class="max-w-2xl">
          <p class="inline-flex items-center gap-2 rounded-full border border-primary-400/40 bg-primary-500/10 px-4 py-2 text-sm font-semibold text-primary-200"><span class="h-2 w-2 rounded-full bg-primary-400"></span>Free website improvement report</p>
          <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.04]">Know exactly <span class="text-primary-400">what to fix next.</span></h1>
          <p class="mt-6 text-lg sm:text-xl leading-relaxed text-gray-300">Skip the generic video review. Send us your URL and receive a one-page, prioritised list of improvements for speed, accessibility, search visibility, cookies, trust, and conversions.</p>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-gray-300">
            <span class="flex items-center gap-2"><span class="text-primary-400">✓</span>Clear priorities</span>
            <span class="flex items-center gap-2"><span class="text-primary-400">✓</span>No jargon</span>
            <span class="flex items-center gap-2"><span class="text-primary-400">✓</span>Delivered within 2 days</span>
          </div>
          <a href="#audit-form" class="mt-9 bg-primary-500 text-white px-7 py-4 rounded-lg hover:bg-primary-400 transition font-semibold text-lg inline-flex items-center justify-center">Request my report</a>
        </div>

        <div class="relative rounded-2xl border border-white/10 bg-white p-5 sm:p-7 shadow-2xl shadow-black/30 lg:rotate-2">
          <div class="flex items-center justify-between border-b border-gray-200 pb-5"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-primary-600">Example output</p><h2 class="mt-1 text-xl font-bold text-gray-950">Your improvement report</h2></div><span class="rounded-full bg-gray-950 px-3 py-1.5 text-xs font-semibold text-white">1 page</span></div>
          <div class="mt-5 space-y-3">
            <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-lg bg-rose-50 px-4 py-3"><span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span><span class="text-sm font-medium text-gray-800">Layout shifts on mobile</span><span class="text-xs font-bold uppercase tracking-wide text-rose-700">High impact</span></div>
            <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-lg bg-amber-50 px-4 py-3"><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span><span class="text-sm font-medium text-gray-800">Cookie scripts before consent</span><span class="text-xs font-bold uppercase tracking-wide text-amber-700">Review</span></div>
            <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-lg bg-amber-50 px-4 py-3"><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span><span class="text-sm font-medium text-gray-800">Missing page descriptions</span><span class="text-xs font-bold uppercase tracking-wide text-amber-700">Review</span></div>
            <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-lg bg-emerald-50 px-4 py-3"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span><span class="text-sm font-medium text-gray-800">HTTPS and security headers</span><span class="text-xs font-bold uppercase tracking-wide text-emerald-700">Good</span></div>
          </div>
          <p class="mt-5 border-t border-gray-200 pt-4 text-sm leading-relaxed text-gray-500">Every item includes why it matters, the likely impact, and the most sensible next step.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24 bg-white" aria-label="What we check">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.72fr_1.28fr] gap-10 lg:gap-16 mb-12 lg:mb-16">
        <div><p class="text-sm font-bold uppercase tracking-[0.18em] text-primary-600">The checklist</p><h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-gray-950">A proper website review goes beyond an SEO score.</h2></div>
        <p class="self-end text-lg leading-relaxed text-gray-600">We look at the signals visitors, browsers, search engines, and privacy-conscious customers actually experience. The result is a focused improvement list, not a wall of automated warnings.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-px overflow-hidden rounded-2xl border border-gray-200 bg-gray-200">
        {auditAreas.map((area) => (
          <article class="group bg-white p-7 sm:p-8 transition hover:bg-gray-950">
            <div class="flex items-start justify-between gap-4"><span class="font-mono text-sm font-bold text-primary-600 group-hover:text-primary-300">{area.number}</span><span class="h-8 w-8 rounded-full border border-gray-200 text-center leading-7 text-gray-400 transition group-hover:border-white/20 group-hover:text-white">↗</span></div>
            <h3 class="mt-10 text-2xl font-bold tracking-tight text-gray-950 group-hover:text-white">{area.title}</h3>
            <p class="mt-3 leading-relaxed text-gray-600 group-hover:text-gray-300">{area.summary}</p>
            <ul class="mt-6 space-y-3 border-t border-gray-100 pt-5 text-sm text-gray-600 group-hover:border-white/15 group-hover:text-gray-300">{area.checks.map((check) => <li class="flex gap-3"><span class="text-primary-500">•</span><span>{check}</span></li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="audit-form" class="py-20 bg-primary-500" aria-label="Request your improvement report">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-2xl p-8 md:p-12">
        <div class="text-center mb-10"><p class="text-sm font-bold uppercase tracking-[0.18em] text-primary-600">Request yours</p><h2 class="mt-3 text-3xl sm:text-4xl font-bold text-black">Get your free improvement report</h2><p class="mt-4 text-lg text-gray-600">Tell us where to look and where to send your one-page findings.</p></div>
        <form name="site-audit" method="POST" action="/api/forms" class="max-w-2xl mx-auto space-y-6">
          <input type="hidden" name="form-name" value="site-audit" />
          <div class="hidden" aria-hidden="true"><label>Do not fill this out if you are human: <input name="bot-field" type="text" aria-hidden="true" tabindex="-1" autocomplete="off" /></label></div>
          <div><label for="audit-url" class="block text-sm font-medium text-gray-700 mb-2">Website URL</label><input id="audit-url" type="url" name="website" required placeholder="https://yourbusiness.co.uk" class="w-full px-4 py-4 rounded-lg border border-gray-200 bg-white text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-200" /></div>
          <div><label for="audit-email" class="block text-sm font-medium text-gray-700 mb-2">Email address</label><input id="audit-email" type="email" name="email" required placeholder="your@email.com" class="w-full px-4 py-4 rounded-lg border border-gray-200 bg-white text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-200" /></div>
          <div><label for="audit-name" class="block text-sm font-medium text-gray-700 mb-2">Your name (optional)</label><input id="audit-name" type="text" name="name" placeholder="Jane Smith" class="w-full px-4 py-4 rounded-lg border border-gray-200 bg-white text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-200" /></div>
          <TurnstileWidget />
          <button type="submit" class="w-full bg-gray-900 text-white px-6 py-4 rounded-lg hover:bg-gray-800 transition font-semibold text-lg">Send my improvement report</button>
          <p class="text-sm text-gray-500 text-center">Free and confidential. No spam. Your report usually arrives within 2 business days.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50"><div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center"><h2 class="text-2xl sm:text-3xl font-bold text-black mb-4">Prefer to talk it through?</h2><p class="text-lg text-gray-600 mb-8">Book a free 30-minute call and we’ll talk through your goals, budget and timeline.</p><a href="https://calendly.com/meonvalleyweb/30min" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-primary-500 text-white px-8 py-4 rounded-lg hover:bg-primary-600 transition font-medium text-lg">Book a call</a></div></section>
</MainLayout>
