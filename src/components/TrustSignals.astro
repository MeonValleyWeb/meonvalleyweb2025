---
import { business } from '../data/site';

const signals = [
  { title: 'Hampshire based', detail: 'Direct, local support from the person doing the work.' },
  { title: 'Accessible by design', detail: 'Clear journeys that work across devices and abilities.' },
  { title: 'Built for ownership', detail: 'Straightforward technology without proprietary lock-in.' },
  { title: 'Community committed', detail: 'Ongoing website support for charities and local causes.' },
];
---

<section class="border-y border-gray-200 bg-white" aria-label="Why clients choose Meon Valley Web">
  <div class="mx-auto grid max-w-7xl grid-cols-1 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
    {signals.map((signal, index) => (
      <div class:list={[
        'py-6 sm:px-6 lg:py-8',
        index > 0 && 'border-t border-gray-200 sm:border-t-0',
        index % 2 === 1 && 'sm:border-l',
        index > 1 && 'sm:border-t lg:border-t-0',
        index > 0 && 'lg:border-l',
      ]}>
        <p class="font-semibold text-gray-950">{signal.title}</p>
        <p class="mt-1 text-sm leading-relaxed text-gray-600">{signal.detail}</p>
      </div>
    ))}
  </div>
  <div class="sr-only">
    <a href={business.googleBusinessUrl}>View Meon Valley Web on Google</a>
  </div>
</section>
