---
import { Image } from 'astro:assets';
import astroLogo from '../assets/astro.png';
---

<section class="bg-gray-950 py-20 text-white" aria-labelledby="modern-delivery-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 id="modern-delivery-title" class="text-3xl font-bold tracking-tight sm:text-4xl">Modern technology should make the experience simpler.</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-300">The right tools keep editing familiar, pages fast and support straightforward.</p>
    </div>

    <div class="delivery-flow mt-12 grid gap-5 md:grid-cols-[1fr_auto_1.15fr_auto_1fr] md:items-stretch">
      <article class="flow-stage bg-white p-6 text-gray-950">
        <img src="/wordpress-tile.svg" alt="WordPress" class="h-10 w-auto" loading="lazy" decoding="async" />
        <h3 class="mt-8 text-2xl font-bold">Shape content</h3>
        <p class="mt-3 text-gray-600">Use a familiar editor where your team needs one.</p>
      </article>
      <div class="flow-connector" aria-hidden="true"><span></span></div>
      <article class="flow-stage flow-stage-featured border border-primary-400/40 bg-primary-500 p-7 text-white">
        <Image src={astroLogo} alt="Astro" width={134} height={48} fit="contain" class="h-10 w-auto brightness-0 invert" format="webp" />
        <h3 class="mt-10 text-3xl font-bold">Build for speed</h3>
        <p class="mt-3 text-primary-50">Send less code and give every visitor a faster first impression.</p>
      </article>
      <div class="flow-connector" aria-hidden="true"><span></span></div>
      <article class="flow-stage border border-white/15 bg-gray-900 p-6 text-white">
        <p class="font-mono text-sm font-semibold text-primary-300">CLOUDFLARE EDGE</p>
        <h3 class="mt-8 text-2xl font-bold">Deliver reliably</h3>
        <p class="mt-3 text-gray-300">Secure delivery, sensible caching and dependable hosting.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .flow-stage { border-radius: 1rem; }
  .flow-connector { position: relative; min-height: 2rem; }
  .flow-connector::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    content: '';
    background: rgb(255 255 255 / 0.25);
  }
  .flow-connector span {
    position: absolute;
    top: calc(50% - 3px);
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #ee74a7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .flow-connector span { animation: flow-pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  }
  @media (min-width: 768px) {
    .flow-stage-featured { transform: translateY(-1.5rem); }
    .flow-connector { width: 4rem; }
  }
  @media (max-width: 767px) {
    .flow-connector { height: 3rem; }
    .flow-connector::before { top: 0; left: 50%; width: 1px; height: 100%; }
    .flow-connector span { top: 0; left: calc(50% - 3px); }
  }
  @keyframes flow-pulse {
    0% { transform: translateX(0); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateX(4rem); opacity: 0; }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
    .flow-connector span { animation-name: flow-pulse-mobile; }
  }
  @keyframes flow-pulse-mobile {
    0% { transform: translateY(0); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(3rem); opacity: 0; }
  }
</style>
