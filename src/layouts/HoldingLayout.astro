---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/rebrand-transition.webp' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Meon Valley Web',
  url: 'https://meonvalleyweb.com',
  description,
  sameAs: ['https://source120.com'],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/Meon_Valley_Icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meon Valley Web" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="A charcoal folded card and raspberry paper ribbon suggesting a new direction" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="A charcoal folded card and raspberry paper ribbon suggesting a new direction" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f6f4ef;
  }

  :global(body) {
    margin: 0;
    background: #f6f4ef;
    color: #15171c;
    font-family: 'Aptos', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
  }

  .skip-link {
    position: absolute;
    top: -4rem;
    left: 1rem;
    z-index: 10;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: #15171c;
    color: #fff;
    font-weight: 700;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
