{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meonvalleyweb2025",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-23",
  "build": {
    "command": "npm run build"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET"]
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
